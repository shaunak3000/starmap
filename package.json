{
  "name": "starmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/fetch-athyg.ts",
    "data:build": "tsx scripts/build-catalog.ts",
    "data": "npm run data:fetch && npm run data:build",
    "check:camera": "tsx scripts/check-camera.ts",
    "shoot": "tsx scripts/shoot.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
